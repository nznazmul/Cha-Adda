# CHA ADDA — Environment Configuration
# Copy this file to .env.local and populate with your Supabase project credentials

# The base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Publishable Key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (NEVER expose to browser, keep server-only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Storage Bucket Name (default: 'profile-photos')
NEXT_PUBLIC_STORAGE_BUCKET=profile-photos
